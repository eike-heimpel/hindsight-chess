# Coach LLM (OpenRouter — Gemini Flash by default)
# Without this, the app falls back to a deterministic stub coach. Useful for
# `npm run dev` and tests; set USE_STUB_COACH=1 to force the stub even with a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~google/gemini-flash-latest
# USE_STUB_COACH=1

# MongoDB Atlas (positions, history, coach response cache, Lichess staging).
# Without these, the app falls back to the static bank.json — no history, no
# cache, no picker filtering by solved.
MONGODB_URI=
MONGODB_DB_NAME=my-chess

# Better Auth (magic-link login, stored in the same Mongo DB). Both required to
# enable auth; without them the auth seam resolves no user. Generate the secret
# with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app — http://localhost:5173 in dev, the deployed origin in prod.
BETTER_AUTH_URL=http://localhost:5173
