# Coach LLM (OpenRouter — Gemini Flash by default)
# Without this, the app falls back to a deterministic stub coach. Useful for
# `npm run dev` and tests; set USE_STUB_COACH=1 to force the stub even with a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~google/gemini-flash-latest
# Model for the home card's one-line "story" headline (a small fast model is
# plenty). Plain id — no `~` auto-router prefix. Defaults to gemini-2.5-flash-lite.
OPENROUTER_HEADLINE_MODEL=google/gemini-2.5-flash-lite
# Guided-coach models (both optional — have defaults). COACH_SPIKE_MODEL drives
# the coaching discussion (needs reasoning headroom); COACH_GATE_MODEL is the
# cheap grounding gate that checks the reply against the FACTS.
# COACH_SPIKE_MODEL=google/gemini-3.5-flash
# COACH_GATE_MODEL=google/gemini-2.5-flash-lite
# USE_STUB_COACH=1

# lichess game import (optional). The game-export API works anonymously; a
# personal access token only raises rate limits. Create one at
# https://lichess.org/account/oauth/token (no scopes needed for public games).
LICHESS_TOKEN=

# MongoDB Atlas (positions, history, coach response cache, Lichess staging).
# Without these, the app falls back to the static bank.json — no history, no
# cache, no picker filtering by solved.
MONGODB_URI=
MONGODB_DB_NAME=my-chess

# Better Auth (magic-link login, stored in the same Mongo DB). Both required to
# enable auth; without them the auth seam resolves no user. Generate the secret
# with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app — http://localhost:5173 in dev, the deployed origin in prod.
BETTER_AUTH_URL=http://localhost:5173

# Email (Postmark) for magic-link delivery. Both required to actually send;
# without them the link is logged to the dev console and prod fails fast.
# EMAIL_FROM must be a verified Sender Signature (or on a verified domain).
# POSTMARK_MESSAGE_STREAM defaults to "outbound"; set it if you use a custom stream.
POSTMARK_API_TOKEN=
EMAIL_FROM=
POSTMARK_MESSAGE_STREAM=outbound
